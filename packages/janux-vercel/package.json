{
  "name": "@janux/vercel",
  "version": "0.6.0",
  "description": "Deploy a Janux app to Vercel — Bun functions for server apps, prerendered HTML for static ones.",
  "repository": {
    "type": "git",
    "url": "https://github.com/aralroca/Janux.git"
  },
  "license": "MIT",
  "author": {
    "name": "Aral Roca Gomez",
    "email": "contact@aralroca.com"
  },
  "homepage": "https://github.com/aralroca/Janux#readme",
  "bugs": "https://github.com/aralroca/Janux/issues",
  "keywords": [
    "janux",
    "vercel",
    "adapter",
    "bun",
    "deploy"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "janux-vercel": "./bin.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/src/index.js",
    "module": "./dist/src/index.js",
    "types": "./dist/src/index.d.ts",
    "bin": {
      "janux-vercel": "./dist/bin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      }
    }
  },
  "dependencies": {
    "@janux/agent": "workspace:*",
    "@janux/cli": "workspace:*",
    "@janux/server": "workspace:*",
    "@janux/vite": "workspace:*"
  },
  "devDependencies": {
    "janux": "workspace:*"
  },
  "scripts": {
    "prepublishOnly": "bun ../../scripts/prepublish-guard.ts"
  }
}
