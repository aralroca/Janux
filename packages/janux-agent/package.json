{
  "name": "@janux/agent",
  "version": "0.7.0",
  "description": "Janux embedded agent runtime: zero-config model resolution, provider routing and the ui/api tool loop.",
  "repository": {
    "type": "git",
    "url": "https://github.com/aralroca/Janux.git"
  },
  "license": "MIT",
  "author": {
    "name": "Aral Roca Gomez",
    "email": "contact@aralroca.com"
  },
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./local": "./src/local/index.ts"
  },
  "dependencies": {
    "janux": "workspace:*",
    "@janux/server": "workspace:*",
    "@aralroca/gui-agent": "^0.5.0",
    "ai": "^6.0.0"
  },
  "peerDependencies": {
    "@browser-ai/transformers-js": ">=2.2.0",
    "@huggingface/transformers": ">=3.7.0",
    "pg": ">=8",
    "ioredis": ">=5"
  },
  "peerDependenciesMeta": {
    "@browser-ai/transformers-js": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@browser-ai/transformers-js": "^2.2.2",
    "@happy-dom/global-registrator": "^20.11.1",
    "@types/pg": "^8.20.0",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0"
  },
  "homepage": "https://github.com/aralroca/Janux#readme",
  "bugs": "https://github.com/aralroca/Janux/issues",
  "keywords": [
    "janux",
    "agentic-ui",
    "mcp",
    "webmcp",
    "ai-agents",
    "fullstack",
    "framework",
    "bun",
    "vite",
    "resumability",
    "copilot"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/src/index.js",
    "module": "./dist/src/index.js",
    "types": "./dist/src/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./local": {
        "types": "./dist/src/local/index.d.ts",
        "default": "./dist/src/local/index.js"
      }
    }
  },
  "scripts": {
    "prepublishOnly": "bun ../../scripts/prepublish-guard.ts"
  }
}
