{
  "name": "@janux/tailwind",
  "version": "0.5.0",
  "description": "Zero-config Tailwind CSS v4 integration for Janux. Install it and it's on.",
  "repository": {
    "type": "git",
    "url": "https://github.com/aralroca/Janux.git"
  },
  "license": "MIT",
  "author": {
    "name": "Aral Roca Gomez",
    "email": "contact@aralroca.com"
  },
  "homepage": "https://github.com/aralroca/Janux#readme",
  "bugs": "https://github.com/aralroca/Janux/issues",
  "keywords": [
    "janux",
    "tailwindcss",
    "tailwind",
    "vite",
    "integration"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "style": "./tailwind.css",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "tailwind.css"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/src/index.js",
    "module": "./dist/src/index.js",
    "types": "./dist/src/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "style": "./tailwind.css",
        "default": "./dist/src/index.js"
      }
    }
  },
  "dependencies": {
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0"
  },
  "style": "./tailwind.css",
  "scripts": {
    "prepublishOnly": "bun ../../scripts/prepublish-guard.ts"
  }
}
