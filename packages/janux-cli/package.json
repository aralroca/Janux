{
  "name": "@janux/cli",
  "version": "0.6.0",
  "description": "Janux CLI: dev (Vite), build (client bundle) and start (production server on Bun).",
  "repository": {
    "type": "git",
    "url": "https://github.com/aralroca/Janux.git"
  },
  "license": "MIT",
  "author": {
    "name": "Aral Roca Gomez",
    "email": "contact@aralroca.com"
  },
  "type": "module",
  "bin": {
    "janux": "./bin.ts"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./prod": "./src/prod.ts",
    "./adapter": "./src/adapter.ts",
    "./adapter/build": "./src/adapter-build.ts"
  },
  "dependencies": {
    "janux": "workspace:*",
    "@janux/server": "workspace:*",
    "@janux/agent": "workspace:*",
    "@janux/vite": "workspace:*",
    "vite": "^7.3.0"
  },
  "homepage": "https://github.com/aralroca/Janux#readme",
  "bugs": "https://github.com/aralroca/Janux/issues",
  "keywords": [
    "janux",
    "agentic-ui",
    "mcp",
    "webmcp",
    "ai-agents",
    "fullstack",
    "framework",
    "bun",
    "vite",
    "resumability",
    "copilot"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/src/index.js",
    "module": "./dist/src/index.js",
    "types": "./dist/src/index.d.ts",
    "bin": {
      "janux": "./dist/bin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./prod": {
        "types": "./dist/src/prod.d.ts",
        "default": "./dist/src/prod.js"
      },
      "./adapter": {
        "types": "./dist/src/adapter.d.ts",
        "default": "./dist/src/adapter.js"
      },
      "./adapter/build": {
        "types": "./dist/src/adapter-build.d.ts",
        "default": "./dist/src/adapter-build.js"
      }
    }
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "prepublishOnly": "bun ../../scripts/prepublish-guard.ts"
  }
}
