{
  "name": "@janux/server",
  "version": "0.5.0",
  "description": "Janux fullstack server: SSR, api() RPC endpoints that double as agent tools, manifest service and MCP surface.",
  "repository": {
    "type": "git",
    "url": "https://github.com/aralroca/Janux.git"
  },
  "license": "MIT",
  "author": {
    "name": "Aral Roca Gomez",
    "email": "contact@aralroca.com"
  },
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./platform": "./src/platform.ts"
  },
  "dependencies": {
    "janux": "workspace:*",
    "web-bot-auth": "^0.1.3"
  },
  "homepage": "https://github.com/aralroca/Janux#readme",
  "bugs": "https://github.com/aralroca/Janux/issues",
  "keywords": [
    "janux",
    "agentic-ui",
    "mcp",
    "webmcp",
    "ai-agents",
    "fullstack",
    "framework",
    "bun",
    "vite",
    "resumability",
    "copilot"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/src/index.js",
    "module": "./dist/src/index.js",
    "types": "./dist/src/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./platform": {
        "types": "./dist/src/platform.d.ts",
        "default": "./dist/src/platform.js"
      }
    }
  },
  "scripts": {
    "prepublishOnly": "bun ../../scripts/prepublish-guard.ts"
  }
}
