{
  "name": "janux",
  "version": "0.5.0",
  "description": "Core of Janux, the fullstack framework for the Agentic Web. One component, two faces: a view for humans, typed MCP tools & resources for AI agents.",
  "repository": {
    "type": "git",
    "url": "https://github.com/aralroca/Janux.git"
  },
  "license": "MIT",
  "author": {
    "name": "Aral Roca Gomez",
    "email": "contact@aralroca.com"
  },
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/schema/index.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-dev-runtime.ts",
    "./server": "./src/render/server.ts",
    "./client": "./src/client/index.ts",
    "./worker": "./src/worker/index.ts",
    "./manifest": "./src/manifest/index.ts",
    "./interop": "./src/interop/index.ts",
    "./query": "./src/query/index.ts",
    "./observability": "./src/observability/index.ts"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^18.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "homepage": "https://github.com/aralroca/Janux#readme",
  "bugs": "https://github.com/aralroca/Janux/issues",
  "keywords": [
    "janux",
    "agentic-web",
    "agentic-ui",
    "mcp",
    "webmcp",
    "ai-agents",
    "fullstack",
    "framework",
    "bun",
    "vite",
    "resumability",
    "copilot"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/src/index.js",
    "module": "./dist/src/index.js",
    "types": "./dist/src/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./types": {
        "types": "./dist/src/schema/index.d.ts",
        "default": "./dist/src/schema/index.js"
      },
      "./jsx-runtime": {
        "types": "./dist/src/jsx-runtime.d.ts",
        "default": "./dist/src/jsx-runtime.js"
      },
      "./jsx-dev-runtime": {
        "types": "./dist/src/jsx-dev-runtime.d.ts",
        "default": "./dist/src/jsx-dev-runtime.js"
      },
      "./server": {
        "types": "./dist/src/render/server.d.ts",
        "default": "./dist/src/render/server.js"
      },
      "./client": {
        "types": "./dist/src/client/index.d.ts",
        "default": "./dist/src/client/index.js"
      },
      "./worker": {
        "types": "./dist/src/worker/index.d.ts",
        "default": "./dist/src/worker/index.js"
      },
      "./manifest": {
        "types": "./dist/src/manifest/index.d.ts",
        "default": "./dist/src/manifest/index.js"
      },
      "./interop": {
        "types": "./dist/src/interop/index.d.ts",
        "default": "./dist/src/interop/index.js"
      },
      "./query": {
        "types": "./dist/src/query/index.d.ts",
        "default": "./dist/src/query/index.js"
      },
      "./observability": {
        "types": "./dist/src/observability/index.d.ts",
        "default": "./dist/src/observability/index.js"
      }
    }
  },
  "dependencies": {
    "csstype": "^3.2.3",
    "diff-dom-streaming": "^0.6.9"
  },
  "scripts": {
    "prepublishOnly": "bun ../../scripts/prepublish-guard.ts"
  }
}
